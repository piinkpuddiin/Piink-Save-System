; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=1
general/updates_per_second=100

[application]

config/name="Piink Save System"
config/tags=PackedStringArray("save_system")
run/main_scene="uid://c68l23fwwn5vu"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="uid://bctaociwysg1"
config/macos_native_icon="res://icon.icns"
config/windows_native_icon="res://icon.ico"

[autoload]

GlobalVar="*uid://qact0f167df0"
SaveLoad="*uid://73grmxgpny4x"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[debug]

gdscript/warnings/unused_signal=0

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}
layout/style_directory={}

[display]

window/size/viewport_width=1200
window/size/viewport_height=700
window/size/always_on_top=true
window/size/sharp_corners=true
window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/StyleboxFancy/plugin.cfg", "res://addons/dialogic/plugin.cfg")

[gui]

theme/custom="uid://b2h5wf1wepxar"
theme/custom_font="uid://copsruol437ri"

